rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin UID. Trip authoring + analytics run through the Admin SDK, which
    // bypasses these rules — so these constraints only apply to the client SDK.
    function isAdmin() {
      return request.auth != null && request.auth.uid == '3VE0ucRyv6XHrYEGEpw4JC9KYD43';
    }

    // Trips: metadata public-readable for published trips (homepage/SEO go via the
    // Admin SDK anyway). Day/place content is NEVER client-readable — it is served
    // only by the server: the static preview embed + the token-verified /api/itinerary.
    match /trips/{tripId} {
      allow read: if resource.data.published == true;
      allow write: if isAdmin();

      match /days/{dayId} {
        allow read: if false;
        allow write: if isAdmin();

        match /places/{placeId} {
          allow read: if false;
          allow write: if isAdmin();
        }
      }
    }

    // Users: own profile only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Analytics: written + read exclusively via the Admin SDK (/api/track,
    // /api/admin/analytics). No direct client access.
    match /analytics/{document=**} {
      allow read, write: if false;
    }
  }
}
